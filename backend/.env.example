DATABASE_URL=file:./fintrack.db
PORT=3000
NODE_ENV=development
# Required when NODE_ENV=production:
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional; defaults to 30 (allowed range: 1-365).
SESSION_DURATION_DAYS=30
# Optional online AI and UPI settings:
OPENAI_API_KEY=
GEMINI_API_KEY=
UPI_WEBHOOK_SECRET=
# SMTP settings used for PDF report delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM=FinTrack <you@example.com>
REPORT_TIMEZONE=Asia/Kolkata
# Browser push: generate with `npx web-push generate-vapid-keys`; keep the private key secret.
VAPID_SUBJECT=mailto:you@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Native push, using Firebase Cloud Messaging HTTP v1 service-account values.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
