DATABASE_URL=file:./fintrack.db
PORT=3000
NODE_ENV=development
# Required when NODE_ENV=production:
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=
# Optional; defaults to 30 (allowed range: 1-365).
SESSION_DURATION_DAYS=30
# Optional online AI and UPI settings:
OPENAI_API_KEY=
GEMINI_API_KEY=
UPI_WEBHOOK_SECRET=
