{
  "name": "fintrack-backend",
  "version": "1.0.0",
  "description": "FinTrack - AI-Powered Personal Finance Tracker Backend (Phase 1)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "build:app": "npm --prefix ../frontend run build && npm run build",
    "start": "node dist/main.js",
    "start:app": "npm run build:app && npm start",
    "dev": "prisma generate --schema prisma/schema.prisma && ts-node-dev --respawn --transpile-only src/main.ts",
    "dev:cloud": "prisma generate --schema prisma/schema.postgresql.prisma && node --env-file=.env.cloud ./node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/main.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:cloud": "prisma generate --schema prisma/schema.postgresql.prisma",
    "prisma:db:push": "prisma db push",
    "ownership:phase1": "sh scripts/run-ownership-migration.sh phase1",
    "ownership:verify": "sh scripts/run-ownership-migration.sh verify",
    "ownership:phase2": "sh scripts/run-ownership-migration.sh phase2",
    "seed": "ts-node prisma/seed.ts",
    "test": "set \"DATABASE_URL=file:./test.db\"&& jest --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.14",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
