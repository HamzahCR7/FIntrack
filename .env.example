# Backend settings: copy backend/.env.example to backend/.env.
# Render sets these through render.yaml; never commit actual credentials.
# Optional comma-separated browser origins allowed to call the API directly.
# Capacitor's standard iOS and Android origins are enabled automatically.
CORS_ORIGINS=
# Google OAuth 2.0 Web client ID used by both backend validation and frontend GIS.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=
